# Event Mesh credentials - used in the CPI security material for the AMQP sender adapter
EM_QUEUE=s4-queue-HACKATHON
EM_WSS_URI=wss://bms-isd-9555164b-ab69-4396-8737-d15e71a46e92.us10.a.eventmesh.integration.cloud.sap/protocols/amqp10ws
EM_TOKEN_URL=https://<subaccount>.authentication.us10.hana.ondemand.com/oauth/token
EM_CLIENT_ID=<client id>
EM_CLIENT_SECRET=<client secret>

# DCD receiver (receiver.py) - CPI's User Credentials must use the same user/password
RECEIVER_PORT=8000
# authentication is off by default on CF (REQUIRE_AUTH=false); set REQUIRE_AUTH=true to enable
REQUIRE_AUTH=false
RECEIVER_USER=<user>
RECEIVER_PASSWORD=<password>
# optional instead of / in addition to Basic auth: header X-API-Key
RECEIVER_API_KEY=
ASYNC_PROCESSING=false
